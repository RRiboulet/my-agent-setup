#!/usr/bin/env bash
#
# mcp-catalogue — install this package's MCP server catalogue into the pi agent
# dir of the machine you are on, with every server disabled.
#
# Why it is a separate file from the module it runs. The module lives at
# `tools/mcp-catalogue.mjs` and is the only copy of the merge; a setup script, a
# container's postCreate, or a colleague who has just cloned the package needs a
# path to run without a build step, a PATH entry, `jq`, or a TypeScript loader.
# This wrapper supplies that path: it resolves its own directory (so it works
# from any cwd, through a symlink to the package, or from a clone whose location
# moves between installs) and hands every argument to node unchanged.
#
# Never a second implementation. The shell side adds nothing but argv plumbing:
# duplicating the merge in `jq` here is how bin/pi-agent-dir's seeding and this
# command would drift apart, and the spec's design note names that explicitly.
#
# Usage:
#   bin/mcp-catalogue                 add the catalogue servers this agent dir is missing
#   bin/mcp-catalogue --if-missing    create <agent dir>/mcp.json only if it is absent
#   bin/mcp-catalogue -h|--help       the module's usage, exit codes and modes
#
# Environment: PI_CODING_AGENT_DIR selects the agent dir; unset or empty falls
# back to $HOME/.pi/agent, exactly as pi resolves it. No network call, no OAuth,
# no connection to any server: this writes one file.

set -euo pipefail

# BASH_SOURCE, not $0: a `source` or a `sh script` would otherwise name the
# caller. Then follow symlinks by hand, because `cd` follows a symlinked
# *directory* and not the script file itself: a `bin/mcp-catalogue` symlinked onto
# PATH must still find the module in the package it points at. `readlink -f` would
# do it in one line, but it does not exist on macOS, where a colleague's host may
# well be.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
	TARGET="$(readlink -- "$SELF")" || break
	case "$TARGET" in
	/*) SELF="$TARGET" ;;
	*) SELF="$(dirname -- "$SELF")/$TARGET" ;;
	esac
done
SELF_DIR="$(cd -- "$(dirname -- "$SELF")" && pwd)"
MODULE="$SELF_DIR/../tools/mcp-catalogue.mjs"

if [ ! -f "$MODULE" ]; then
	printf 'mcp-catalogue: cannot find %s\n' "$MODULE" >&2
	exit 2
fi

exec node "$MODULE" "$@"
