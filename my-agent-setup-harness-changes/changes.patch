+					break;
+				}
+				if (t.value.startsWith("-")) {
+					if (SHELL_ENV_WITH_ARG.has(t.value)) idx += 2;
+					else idx += 1;
+					continue;
+				}
+				break;
+			}
+			continue;
+		}
