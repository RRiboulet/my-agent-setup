+	while (idx < tokens.length) {
+		const arg = tokens[idx]!.value;
+		if (arg === "--") {
+			idx += 1;
+			break;
+		}
+		if (GIT_GLOBAL_OPTS_WITH_ARG.has(arg)) {
+			idx += 2;
+			continue;
+		}
+		if (arg.startsWith("-")) {
