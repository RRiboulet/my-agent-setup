+				idx += 1;
+				if (flag === "--") break;
+			}
+			if (lookupOnly) return false;
+			continue;
+		}
+		if (cmd === "exec") {
+			idx += 1;
+			while (idx < tokens.length && tokens[idx]!.value.startsWith("-")) {
+				const flag = tokens[idx]!.value;
+				if (flag === "--") {
+					idx += 1;
+					break;
+				}
+				if (flag === "-a") {
+					idx += 2;
+					continue;
+				}
+				idx += 1;
+			}
+			continue;
+		}
+		if (cmd === "time") {
+			idx += 1;
+			while (idx < tokens.length && tokens[idx]!.value.startsWith("-")) {
