+			entries: [],
+			continue: false,
+			outcome: "completed",
+			context: {},
+		})) as { continue?: boolean };
+		assert.equal(clearedProposal.continue, undefined);
+		const clearedVerdict = gateVerdictOf(clearedProposal);
+		assert.equal(clearedVerdict.decision, "report");
+		assert.deepEqual(clearedVerdict.blockedBy, []);
+	});
