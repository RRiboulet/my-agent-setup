# --- Repository & harness ignores ---
node_modules/
*.log
.DS_Store
# local pi session state (`.pi/settings.json` is intentionally tracked)
.pi/todos/
.pi/npm/
lab/
# Android build leftovers (`local.properties`, generated SDK paths, APKs)
# that should not be tracked in git when building inside a checkout.
local.properties
.artifacts/
*.apk
.worktrees/

# Bench sessions are local transcripts, not results.
tools/bench/results/**/sessions/

# --- From agent-skills ---
*.py[cod]
*.pyc
__pycache__/
# show-me-your-work logs are working artifacts
decisions.tsv
.audit/
