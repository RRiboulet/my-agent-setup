{
  "version": 1,
  "attemptCap": 3,
  "block": {
    "openTodos": false,
    "repeatedFailure": false,
    "loops": false,
    "waitForSubagents": false
  },
  "verification": {
    "command": "node --test --test-concurrency=8 .pi/extensions/subagent/test/*.test.ts",
    "timeoutMs": 300000,
    "maxOutputBytes": 16000,
    "successPattern": "fail 0"
  },
  "advisor": {
    "provider": "opencode-go",
    "model": "glm-5.3-flash",
    "cooldownMs": 600000,
    "budget": 2,
    "minGateBlocks": 2,
    "timeoutMs": 60000,
    "redact": true,
    "fallback": {
      "provider": "openrouter",
      "model": "anthropic/claude-haiku-5-5"
    }
  },
  "workspace": {
    "lockScope": "worktree"
  }
}
