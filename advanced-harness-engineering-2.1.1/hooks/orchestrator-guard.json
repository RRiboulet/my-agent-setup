{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "python3 -S \"${CLAUDE_PLUGIN_ROOT:-$COPILOT_HOOK_DIR/..}/orchestrator_guard/cli.py\" userPromptSubmitted",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "view|grep|glob|edit|create|task|bash",
        "bash": "python3 -S \"${CLAUDE_PLUGIN_ROOT:-$COPILOT_HOOK_DIR/..}/orchestrator_guard/cli.py\" preToolUse",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "view|grep|glob|edit|create|task|bash|write_agent|read_bash",
        "bash": "python3 -S \"${CLAUDE_PLUGIN_ROOT:-$COPILOT_HOOK_DIR/..}/orchestrator_guard/cli.py\" postToolUse",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "python3 -S \"${CLAUDE_PLUGIN_ROOT:-$COPILOT_HOOK_DIR/..}/orchestrator_guard/cli.py\" subagentStart",
        "timeoutSec": 5
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "python3 -S \"${CLAUDE_PLUGIN_ROOT:-$COPILOT_HOOK_DIR/..}/orchestrator_guard/cli.py\" subagentStop",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 -S \"${CLAUDE_PLUGIN_ROOT:-$COPILOT_HOOK_DIR/..}/orchestrator_guard/cli.py\" agentStop",
        "timeoutSec": 5
      }
    ]
  }
}
