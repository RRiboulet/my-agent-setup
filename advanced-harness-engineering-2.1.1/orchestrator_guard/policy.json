{
  "version": 1,
  "default_mode": "qa",
  "direct_prefix": "!direct",
  "stop_block_sentinel": "[orchestrator-guard:verify-required]",
  "discovery_tools": ["view", "grep", "glob"],
  "discovery_budgets": {
    "qa": 8,
    "debug": 5,
    "review": 5,
    "implement": 4,
    "quick-fix": 4,
    "security": 2
  },
  "mode_directives": {
    "security": "Mode: security (direct discovery budget: {budget}). Delegate vulnerability inspection to `security-review` first; avoid broad manual reads or test runs on the parent.",
    "review": "Mode: review (direct discovery budget: {budget}). Delegate diff review to `code-review` and broader lookups to `explore`; keep parent shell calls read-only.",
    "debug": "Mode: debug (direct discovery budget: {budget}). Delegate broad search to `explore` and test/repro/fix execution to `general-purpose`.",
    "implement": "Mode: implement (direct discovery budget: {budget}). Plan on the parent, then delegate discovery to `explore` and code/test execution to `general-purpose`.",
    "quick-fix": "Mode: quick-fix (direct discovery budget: {budget}). Keep tiny single-file edits surgical or delegate to `general-purpose`; delegate tests/lint to `general-purpose`.",
    "qa": "Mode: qa (direct discovery budget: {budget}). Answer directly for small lookups; delegate broad or multi-area codebase discovery to `explore`."
  },
  "classifier_rules": [
    {
      "mode": "security",
      "patterns": [
        "/security-review\\b",
        "\\bsecurity\\s+(review|audit|check|scan)\\b",
        "\\bvulnerabilit(y|ies)\\b",
        "\\bexploit(able)?\\b",
        "\\b(auth|token|secret|credential)\\s+(leak|bypass|exposure)\\b",
        "\\b(sql\\s+injection|xss|csrf|ssrf|rce)\\b"
      ]
    },
    {
      "mode": "review",
      "patterns": [
        "/review\\b",
        "\\bcode[\\s-]review\\b",
        "\\breview\\b.*\\b(pr|pull\\s+request|diff|branch|changes?|commit)\\b",
        "\\b(pr|pull\\s+request|diff|branch)\\b.*\\breview\\b"
      ]
    },
    {
      "mode": "debug",
      "patterns": [
        "\\b(debug|diagnose|troubleshoot|investigate)\\b",
        "\\b(failing|broken|crash(es|ing)?|traceback|stack\\s*trace|exception|flaky|regression)\\b",
        "\\b(keyerror|typeerror|valueerror|attributeerror|assertionerror|importerror)\\b",
        "\\bwhy\\s+(is|does|did|are)\\b.*\\b(fail|break|error|crash|hang|slow)\\b"
      ]
    },
    {
      "mode": "implement",
      "patterns": [
        "\\b(implement|build|create|add|refactor|migrate|wire|integrate|introduce|rewrite|extract|split)\\b",
        "/implement\\b"
      ]
    },
    {
      "mode": "quick-fix",
      "patterns": [
        "\\b(typo|typos|spelling|one[- ]line|1[- ]line|tiny\\s+fix|small\\s+fix|quick\\s+fix|rename\\s+label)\\b"
      ]
    }
  ],
  "bash_read_only_allowlist": {
    "commands": ["ls", "wc"],
    "git_subcommands": ["status", "diff", "log", "branch", "show"],
    "git_allowed_global_flags": ["--no-pager"],
    "git_branch_read_only_flags": ["-a", "--all", "-r", "--remotes", "-v", "-vv", "--list", "--show-current"],
    "safe_pipe_commands": ["head", "tail", "wc", "cat"]
  },
  "parent_write_limits": {
    "max_edit_lines": 20,
    "max_edited_files_per_turn": 1
  },
  "model_mention_patterns": [
    "\\bopus\\b",
    "\\bsonnet\\b",
    "\\bhaiku\\b",
    "\\bneon\\b",
    "\\bhydrogen\\b",
    "\\bdeepseek\\b",
    "\\bgpt\\d*[a-z]?\\b",
    "\\bmodel\\b"
  ],
  "steer_unlock_threshold": 2,
  "verification": {
    "file_rules": {
      "test_extensions": [
        ".py",
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs",
        ".go",
        ".rs",
        ".rb",
        ".java"
      ],
      "review_extensions": [
        ".py",
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".mjs",
        ".cjs",
        ".go",
        ".rs",
        ".rb",
        ".java",
        ".tf",
        ".sql",
        ".sh",
        ".json",
        ".yml",
        ".yaml"
      ],
      "exempt_extensions": [".md", ".txt"]
    },
    "review_threshold_files": 2,
    "review_threshold_lines": 50,
    "verify_commands": {
      "include_patterns": [
        "^pytest$",
        "^ruff$",
        "^unittest$",
        "(?:^|/)run_[A-Za-z0-9_-]*tests\\.sh$",
        "(?:^|/)run_specific_test_file\\.sh$",
        "(?:^|/)tests/test-isolated-[A-Za-z0-9_-]+\\.sh$",
        "^mypy$",
        "^vitest$",
        "^jest$",
        "^eslint$",
        "^tsc$",
        "(?:^|/)scripts/test\\.sh$"
      ],
      "exclude_patterns": [
        "test-local-[A-Za-z0-9_-]*\\.sh\\b",
        "\\buvicorn\\b",
        "\\b--watch\\b"
      ]
    }
  }
}
