# The devcontainer image bakes shell files into the container verbatim.
# CRLF line endings survive the copy and a trailing \r ends up inside sourced
# paths ("no such file or directory: ~/.aliases.zsh^M"), so keep everything LF.
* text=auto eol=lf

# Parallel worktrees append to CHANGELOG.md's Unreleased section; union keeps both sides.
# Local merges only: GitHub's server-side squash merge ignores custom merge drivers.
CHANGELOG.md merge=union