#!/usr/bin/env bash
#
# pi-wrapped — start `pi` with the per-project agent dir a login shell would
# have selected, for launchers that bypass the shell.
#
# Why it exists. `bin/pi-agent-dir --shell` installs a `pi` function in
# ~/.bashrc that picks `<agent root>/agent-<main checkout dir>` for any cwd
# inside the checkout or a worktree of it. That covers a human in a terminal and
# nothing else: a tmux child, a CI step, a scheduler or an editor-launched
# process gets the shell's environment without its rc, so `pi` runs on the
# shared, package-installed agent dir. In a linked worktree that is the exact
# failure the agent-dir split exists for — the tree's own `.pi/extensions` and
# the package's copy of the main checkout register the same tools, and pi exits
# 1 before any model call. See the README section "One copy of the extensions,
# never two".
#
# Usage:
#   pi-wrapped [pi arguments...]
#
#   Every argument is passed to `pi` unchanged and unexamined. There is no
#   option of its own: not --help, not --print, not --, nothing. This is a
#   launcher, not a second command surface, so a flag it does not understand is
#   a flag for pi — including `@file` arguments, values with spaces and an
#   explicit `--`.
#
# Environment:
#   PI_CODING_AGENT_DIR   an agent dir already set here is used as-is; deriving
#                         one never overwrites an explicit choice
#   PI_AGENT_ROOT         where agent dirs live     (default: ~/.pi)
#
# Resolution, in order:
#   1. PI_CODING_AGENT_DIR set and non-blank — use it. An explicit choice
#      outranks a derived one, which is what makes `pi-wrapped` safe to wrap
#      around a launcher that already passes one. Blank counts as unset because
#      that is how pi resolves it (`tools/mcp-catalogue.mjs` records the same
#      rule), so an empty string must not become an agent dir named "".
#   2. Otherwise `<agent root>/agent-<main checkout dir>`, resolved by
#      `bin/pi-agent-dir --print --project "$PWD"` — the helper's own derivation,
#      so this script cannot drift from it. (The `--shell` hook is an inline copy
#      of that rule that assumes the default root and overrides an explicit
#      PI_CODING_AGENT_DIR; this script does neither, deliberately.) `--print`
#      writes nothing and exits non-zero outside a checkout.
#   3. That dir exists (`settings.json` present) — use it.
#   4. Otherwise run `pi` with no override, and say so on stderr. Falling back
#      is deliberate: a launcher that dies because a path could not be derived
#      is worse than one that runs with the defaults, and the interactive hook
#      already treats a missing dir the same way rather than failing the
#      command.
#
# What it does not do: create the dir. Running `pi-agent-dir` without `--print`
# here would seed settings, credentials, trust and the MCP catalogue into the
# user's agent root as a side effect of starting pi, needs `jq` to be installed,
# and — when that seeding fails — leaves a dir that exists but trusts nothing,
# which is a *silently empty* agent (no extensions, no skills) rather than a
# working one. The fix belongs to the person: run `bin/pi-agent-dir` once, which
# reports what it did. This script names it in the note.
#
# Exit status is pi's: `exec` replaces this process, so signals, stdin and the
# terminal belong to pi directly and no wrapper sits in the way of a TUI.

set -euo pipefail

note() {
	printf 'pi-wrapped: %s\n' "$*" >&2
}

if [ -n "${PI_CODING_AGENT_DIR:-}" ]; then
	exec pi "$@"
fi

# `$0`, not `$BASH_SOURCE`: invoked through a symlink the helper would then be
# looked for beside the link, so resolve this script's real location first.
SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
AGENT_DIR_CLI="$SELF_DIR/pi-agent-dir"

# The helper's own failure is the diagnosis, so its stderr is left alone: a
# launcher that silently guesses why is worse than one that says nothing at all.
dir="$("$AGENT_DIR_CLI" --print --project "$PWD")" || dir=''

if [ -z "$dir" ]; then
	note "no per-project agent dir for $PWD; running pi with its defaults"
	exec pi "$@"
fi

if [ ! -f "$dir/settings.json" ]; then
	note "no per-project agent dir at $dir yet (no settings.json); running pi with its defaults (create it once with: $AGENT_DIR_CLI)"
	exec pi "$@"
fi

export PI_CODING_AGENT_DIR="$dir"
exec pi "$@"
